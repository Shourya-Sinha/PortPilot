# PortPilot HomeDeploy Dashboard - environment configuration example.
# Copy to .env and adjust. NEVER commit a real .env file.

# --- Core ---
# Host the management API + dashboard binds to. Default 127.0.0.1 (loopback only).
# Set to 0.0.0.0 ONLY if you want LAN access, and set PORTPILOT_AUTH_TOKEN as well.
PORT=4300
HOST=127.0.0.1

# Reverse proxy (hostname-based routing) listener.
PROXY_PORT=8080
PROXY_HOST=127.0.0.1

# Directory for the SQLite database, secret key and session state.
DATA_DIR=./data
# Where repositories are cloned (per deployment).
WORKSPACES_DIR=./workspaces
# Where built artifacts are stored (versioned per deployment).
ARTIFACTS_DIR=./artifacts
# Where log files are written.
LOGS_DIR=./logs

# --- Security ---
# Session/API token. If empty, a random token is generated at first start and
# printed once to the console (also stored in data/.session-token).
# REQUIRED when HOST is not loopback.
# PORTPILOT_AUTH_TOKEN=

# --- Runtime behaviour ---
# Restart applications that were running before PortPilot restarted.
AUTOSTART=true
# Check tracked branches for new commits and redeploy automatically (ms).
# Works without inbound webhooks (no open ports). 0 disables it.
POLL_INTERVAL_MS=300000

# --- GitHub (optional) ---
# Fine-grained PAT with least privilege (Contents: Read on the target repos).
# Used for private repositories, branch listing and webhooks.
# NEVER commit a real token. It is stored encrypted in the database once saved
# through the dashboard, or read from this variable at runtime.
# PORTPILOT_GITHUB_TOKEN=

# --- Optional DNS module ---
# OFF by default. Two modes:
#   local (default)   loopback resolver for machines pointed at this PC
#   authoritative     publishes SOA + NS + wildcard, which is what a registrar
#                     delegation needs (requires a public IP and port 53)
# Port 53 requires administrator/elevated privileges; 5353 does not.
DNS_ENABLED=false
DNS_PORT=5353
DNS_HOST=127.0.0.1
DNS_ZONE=portpilot.home.arpa
DNS_TTL=60
# Authoritative mode (optional). Set these three to publish a real zone:
# DNS_ZONE must be a domain you actually own, e.g. anantainfratech.com
# DNS_NS_NAME is the nameserver name you delegate to, e.g. ns1.anantainfratech.com
# DNS_PUBLIC_IP is the address that hostname resolves to (your public IP)
# DNS_TCP=true is required for public authoritative DNS (large answers + AXFR)
# DNS_NS_NAME=ns1.anantainfratech.com
# DNS_PUBLIC_IP=203.0.113.10
# DNS_TCP=true

# --- Git credential delivery (optional) ---
# helper (default, cross-platform) or askpass (legacy). Run
# `npm run doctor` to prove the chosen mechanism reaches a remote on this PC.
# PORTPILOT_GIT_CREDENTIALS=helper

# --- Public access (optional, never required) ---
# Diagnostics use these endpoints to discover the apparent public IP.
# They fail gracefully when the machine has no internet access.
PUBLIC_IP_CHECK_URL=https://api.ipify.org
